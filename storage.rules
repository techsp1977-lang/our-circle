rules_version = '2';

// Photos and videos are stored at full original quality under each circle.
// Only people in that circle can view or upload them.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(cid) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/circles/$(cid)/access/$(request.auth.uid));
    }

    match /circles/{cid}/{allPaths=**} {
      allow read: if isMember(cid);
      // Up to 2 GB per file so long phone videos fit.
      allow create: if isMember(cid) && request.resource.size < 2 * 1024 * 1024 * 1024;
      allow delete: if isMember(cid);
      allow update: if false;
    }
  }
}
