rules_version = '2';

// Security rules for the family app.
// Every family is a separate "circle". Nobody can read a circle unless they
// have an access record in it. Journals live outside circles and only their
// owner can ever read or write them.
//
// After changing this file, paste it into Firebase → Firestore Database → Rules → Publish.
// Committing it to GitHub alone does not change what Firebase enforces.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function accessPath(cid) { return /databases/$(database)/documents/circles/$(cid)/access/$(request.auth.uid); }
    function isMember(cid) { return signedIn() && exists(accessPath(cid)); }
    function me(cid) { return get(accessPath(cid)).data.memberId; }
    function isAdmin(cid) { return isMember(cid) && get(accessPath(cid)).data.role == 'admin'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    // Document ids end up inside the page's HTML, so only plain letters, digits, _ and - are allowed.
    function okId(id) { return id.matches('^[A-Za-z0-9_-]{1,64}$'); }
    function memberDoc(cid, mid) { return get(/databases/$(database)/documents/circles/$(cid)/members/$(mid)).data; }
    function invitePath(cid, code) { return /databases/$(database)/documents/circles/$(cid)/invites/$(code); }

    // Face ID passkeys and their one-time challenges: only the passkey server function touches these.
    match /passkeys/{id} { allow read, write: if false; }
    match /passkeyChallenges/{id} { allow read, write: if false; }
    // Whether plans are switched on (the app shows trial and plan notices only then). Only the server writes it.
    match /config/{doc} { allow read: if signedIn(); allow write: if false; }
    // Payments (for the owner's Admin numbers): only the server touches these.
    match /payments/{id} { allow read, write: if false; }
    // Server-only settings (the notification signing keys).
    match /_server/{rest=**} { allow read, write: if false; }

    // Personal settings (circle list, check-in preferences). Owner only.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Private journals. Owner only, always. Once a journal is locked (journals/{uid}.lock), pages and goals
    // may only be saved encrypted, and the lock can't be removed, so an old copy of the app on another
    // device can't quietly save readable pages.
    function ownsJournal(uid) { return signedIn() && request.auth.uid == uid; }
    function journalLocked(uid) {
      return exists(/databases/$(database)/documents/journals/$(uid))
        && get(/databases/$(database)/documents/journals/$(uid)).data.get('lock', null) != null;
    }
    match /journals/{uid} {
      allow read: if ownsJournal(uid);
      allow create: if ownsJournal(uid);
      allow update: if ownsJournal(uid) && (resource.data.get('lock', null) == null || request.resource.data.get('lock', null) != null);
      allow delete: if ownsJournal(uid) && resource.data.get('lock', null) == null;
      match /entries/{day} {
        allow read, delete: if ownsJournal(uid);
        allow create, update: if ownsJournal(uid) && (!journalLocked(uid) || !request.resource.data.keys().hasAny(['sections']));
      }
      match /goals/{goal} {
        allow read, delete: if ownsJournal(uid);
        allow create, update: if ownsJournal(uid) && (!journalLocked(uid) || !request.resource.data.keys().hasAny(['title']));
      }
    }

    match /circles/{cid} {
      allow read: if isMember(cid);
      // Plan, storage use and paused uploads are set only by the server; a new circle's trial starts now.
      allow create: if signedIn() && okId(cid) && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['billing', 'usage', 'paused'])
        && request.resource.data.createdAt is int && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 86400000;
      allow update: if isAdmin(cid) && !changed().hasAny(['billing', 'usage', 'paused', 'createdAt', 'createdBy']);
      allow delete: if false;

      // Who has an account in this circle, and which family member they are.
      match /access/{uid} {
        allow read: if isMember(cid) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid && (
          // The founder makes themself admin in the same batch that creates the circle.
          (request.resource.data.role == 'admin'
             && getAfter(/databases/$(database)/documents/circles/$(cid)).data.createdBy == request.auth.uid
             && !exists(/databases/$(database)/documents/circles/$(cid)))
          ||
          // Everyone else joins with a one-time invite for a specific family member who has no login yet,
          // and must mark the invite used in the same batch (so one link can't let several accounts in).
          // They join as a member, or as an organizer when an organizer marked the invite that way.
          ((request.resource.data.role == 'member'
              || (request.resource.data.role == 'admin' && get(invitePath(cid, request.resource.data.invite)).data.get('organizer', false) == true))
             && request.resource.data.keys().hasOnly(['memberId', 'role', 'invite'])
             && get(invitePath(cid, request.resource.data.invite)).data.memberId == request.resource.data.memberId
             && get(invitePath(cid, request.resource.data.invite)).data.used == false
             && getAfter(invitePath(cid, request.resource.data.invite)).data.used == true
             && getAfter(invitePath(cid, request.resource.data.invite)).data.usedBy == request.auth.uid
             && memberDoc(cid, request.resource.data.memberId).uid == null)
        );
        // Organizers can change someone's role, never which family member a login belongs to.
        allow update: if isAdmin(cid) && onlyChanges(['role']) && request.resource.data.role in ['admin', 'member'];
        allow delete: if isAdmin(cid) || (signedIn() && request.auth.uid == uid);
      }

      // Invite links. Anyone signed in who has the exact code can look it up.
      match /invites/{code} {
        allow get: if signedIn();
        allow list, delete: if isAdmin(cid);
        // Organizers can invite anyone without a login; parents can invite a child whose profile they manage.
        // Only organizers can make an invite that joins as an organizer.
        allow create: if okId(code)
          && request.resource.data.used == false
          && (request.resource.data.get('organizer', false) == false || isAdmin(cid))
          && memberDoc(cid, request.resource.data.memberId).uid == null
          && (isAdmin(cid) || (isMember(cid) && me(cid) in memberDoc(cid, request.resource.data.memberId).managedBy));
        allow update: if isAdmin(cid) || (
          signedIn() && resource.data.used == false
          && onlyChanges(['used', 'usedBy'])
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && getAfter(accessPath(cid)).data.invite == code
        );
      }

      // Family members, including managed profiles for young kids.
      match /members/{mid} {
        allow read: if isMember(cid);
        allow create: if okId(mid) && (isAdmin(cid) || (isMember(cid)
          && me(cid) in request.resource.data.managedBy
          && request.resource.data.uid == null
          && request.resource.data.claimed == false
          && request.resource.data.householdId == memberDoc(cid, me(cid)).householdId));
        allow update: if isAdmin(cid)
          // People edit their own name and photo, and parents edit the profiles they manage.
          || (isMember(cid) && (mid == me(cid) || me(cid) in resource.data.managedBy) && onlyChanges(['name', 'photo']))
          || (signedIn() && getAfter(accessPath(cid)).data.memberId == mid
                && onlyChanges(['uid', 'claimed'])
                && request.resource.data.uid == request.auth.uid);
        allow delete: if isAdmin(cid) || (isMember(cid) && me(cid) in resource.data.managedBy);
      }

      // Households are set up by organizers.
      match /households/{hid} {
        allow read: if isMember(cid);
        allow create: if isAdmin(cid) && okId(hid);
        allow update, delete: if isAdmin(cid);
      }

      // Shared dates and events (birthdays, anniversaries, graduations, trips).
      match /events/{eid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && okId(eid) && request.resource.data.createdBy == me(cid);
        allow update: if isMember(cid) && !changed().hasAny(['createdBy']) && (
          resource.data.createdBy == me(cid) || isAdmin(cid) || me(cid) in resource.data.memberIds);
        allow delete: if isMember(cid) && (
          resource.data.createdBy == me(cid) || isAdmin(cid) || me(cid) in resource.data.memberIds);
      }

      // Family album posts.
      match /album/{pid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && okId(pid) && request.resource.data.by == me(cid);
        // Anyone in the family can add photos to an album (never remove them);
        // only its creator or an organizer can rename, remove photos or delete it.
        allow update: if isMember(cid) && (resource.data.by == me(cid) || isAdmin(cid) || (
          onlyChanges(['media'])
          && request.resource.data.media.size() > resource.data.media.size()
          && request.resource.data.media.hasAll(resource.data.media)));
        allow delete: if isMember(cid) && (resource.data.by == me(cid) || isAdmin(cid));
      }

      // Conversations: the whole family, a household, one person, or a custom group.
      match /chats/{chatId} {
        function canSeeChat(data) { return data.kind == 'everyone' || me(cid) in data.memberIds; }
        // A chat that doesn't follow the naming rule below (one planted before it existed) is unusable.
        function chatOk(d) {
          return (chatId == 'everyone' && d.kind == 'everyone') || (d.kind != 'everyone' && chatId == 'p_' + d.memberIds.join('_'));
        }
        // Each person may only move their own read and sent times.
        function onlyMine(f) {
          return !changed().hasAny([f])
            || request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys().hasOnly([me(cid)]);
        }
        allow get: if isMember(cid) && (resource == null || (canSeeChat(resource.data) && chatOk(resource.data)));
        // The chat list query can only be checked by who is in the chat; messages stay guarded by chatOk.
        allow list: if isMember(cid) && canSeeChat(resource.data);
        // A chat's id is fixed by who is in it ("p_" + the member ids in order), and only the
        // family-wide chat may be readable by everyone. This stops anyone setting up a chat
        // ahead of time that other people's private messages would land in.
        allow create: if isMember(cid) && (
          (chatId == 'everyone' && request.resource.data.kind == 'everyone' && request.resource.data.memberIds.size() == 0)
          || (request.resource.data.kind in ['direct', 'household', 'group']
              && me(cid) in request.resource.data.memberIds
              && chatId == 'p_' + request.resource.data.memberIds.join('_')
              && (request.resource.data.kind != 'direct' || request.resource.data.memberIds.size() == 2))
        );
        allow update: if isMember(cid) && canSeeChat(resource.data) && chatOk(resource.data)
          && onlyChanges(['lastText', 'lastAt', 'lastBy', 'name', 'reads', 'sent'])
          && onlyMine('reads') && onlyMine('sent')
          && (!changed().hasAny(['lastText', 'lastAt', 'lastBy']) || request.resource.data.lastBy == me(cid));

        match /messages/{msgId} {
          function chatData() { return get(/databases/$(database)/documents/circles/$(cid)/chats/$(chatId)).data; }
          allow read: if isMember(cid) && canSeeChat(chatData()) && chatOk(chatData());
          allow create: if isMember(cid) && canSeeChat(chatData()) && chatOk(chatData()) && request.resource.data.by == me(cid);
          allow update, delete: if isMember(cid) && resource.data.by == me(cid);
        }
      }
    }
  }
}
